<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <!-- Books -->
    <record id="book_1" model="library.book">
        <field name="name">Tiger Hunters</field>
        <field name="author">Ivan Bahrianyi</field>
        <field name="isbn">978-0-00-000001-1</field>
        <field name="publish_year">1944</field>
    </record>
    <record id="book_2" model="library.book">
        <field name="name">Shadows of Forgotten Ancestors</field>
        <field name="author">Mykhailo Kotsiubynsky</field>
        <field name="isbn">978-0-00-000002-8</field>
        <field name="publish_year">1911</field>
    </record>
    <record id="book_3" model="library.book">
        <field name="name">The Forest Song</field>
        <field name="author">Lesya Ukrainka</field>
        <field name="isbn">978-0-00-000003-5</field>
        <field name="publish_year">1911</field>
    </record>
