    </record>
    <record id="copy_2" model="library.copy">
        <field name="book_id" ref="book_1"/>
        <field name="inventory_number">INV-102</field>
        <field name="condition">good</field>
    </record>
    <record id="copy_3" model="library.copy">
        <field name="book_id" ref="book_2"/>
        <field name="inventory_number">INV-103</field>
        <field name="condition">good</field>
    </record>
    <record id="copy_4" model="library.copy">
        <field name="book_id" ref="book_2"/>
        <field name="inventory_number">INV-104</field>
        <field name="condition">damaged</field>
    </record>
    <record id="copy_5" model="library.copy">
        <field name="book_id" ref="book_3"/>
        <field name="inventory_number">INV-105</field>
        <field name="condition">good</field>
    </record>
    <record id="copy_6" model="library.copy">
        <field name="book_id" ref="book_4"/>
        <field name="inventory_number">INV-106</field>
        <field name="condition">new</field>
    </record>

    <!-- Members -->
    <record id="member_1" model="library.member">
        <field name="name">Andrii Melnyk</field>
        <field name="membership_number">M-101</field>
        <field name="email">andrii@example.com</field>
    </record>
    <record id="member_2" model="library.member">
        <field name="name">Sofiia Bondar</field>
        <field name="membership_number">M-102</field>
        <field name="phone">+380501112233</field>
    </record>
    <record id="member_3" model="library.member">
        <field name="name">Maksym Tkachenko</field>
        <field name="membership_number">M-103</field>
    </record>

    <!-- Loans -->
    <record id="loan_1" model="library.loan">
        <field name="copy_id" ref="copy_1"/>
        <field name="member_id" ref="member_1"/>
        <field name="loan_date">2026-09-01</field>
        <field name="state">active</field>
    </record>
    <record id="loan_2" model="library.loan">
        <field name="copy_id" ref="copy_3"/>
        <field name="member_id" ref="member_2"/>
        <field name="loan_date">2026-09-10</field>
        <field name="return_date">2026-09-20</field>
        <field name="state">returned</field>
    </record>
    <record id="loan_3" model="library.loan">
        <field name="copy_id" ref="copy_5"/>
        <field name="member_id" ref="member_3"/>
        <field name="loan_date">2026-10-15</field>
        <field name="state">active</field>
    </record>
    <record id="loan_4" model="library.loan">
        <field name="copy_id" ref="copy_6"/>
        <field name="member_id" ref="member_1"/>
        <field name="loan_date">2026-10-20</field>
        <field name="state">active</field>
