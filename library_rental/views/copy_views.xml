<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="library_copy_view_list" model="ir.ui.view">
        <field name="name">library.copy.list</field>
        <field name="model">library.copy</field>
        <field name="arch" type="xml">
            <list>
                <field name="inventory_number"/>
                <field name="book_id"/>
                <field name="condition"/>
            </list>
        </field>
    </record>

    <record id="library_copy_view_form" model="ir.ui.view">
        <field name="name">library.copy.form</field>
        <field name="model">library.copy</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="book_id"/>
                        <field name="inventory_number"/>
                        <field name="condition"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="library_copy_action" model="ir.actions.act_window">
        <field name="name">Copies</field>
        <field name="res_model">library.copy</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="library_menu_copies" name="Copies" parent="library_menu_root" action="library_copy_action" groups="library_rental.group_library_librarian"/>
</odoo>